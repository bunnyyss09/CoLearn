# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/colearn?retryWrites=true&w=majority

# Same Redis URL on API, WebSocket, and worker instances (ElastiCache or EC2-hosted Redis).
REDIS_URL=redis://:PASSWORD@your-redis-host:6379

JWT_SECRET=use-a-long-random-secret-in-production
GEMINI_API_KEY=

# HTTP port (set to 80 behind reverse proxy, or keep 3000 and terminate TLS on ALB/nginx).
PORT=3000

# Comma-separated browser origins allowed to call this API (your Vercel URL(s)).
CORS_ORIGIN=https://your-app.vercel.app,http://localhost:5173
